{
  "name": "dsh-sidebar-browser-use",
  "version": "0.1.0",
  "description": "Browser-use MCP for DeepSeek Harness: drive the built-in right-sidebar browser through two stable tools (browser_use_list + browser_use_call), keeping the model-facing tool surface constant.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "browser",
    "browser-use"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./mcp/server": "./mcp/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "mcp",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
